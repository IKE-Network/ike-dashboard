<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.1.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.1.0 https://maven.apache.org/xsd/maven-4.1.0.xsd"
         root="true">
    <modelVersion>4.1.0</modelVersion>

    <parent>
        <groupId>network.ike.platform</groupId>
        <artifactId>ike-parent</artifactId>
        <version>207</version>
        <relativePath/>
    </parent>

    <groupId>network.ike.dashboard</groupId>
    <artifactId>ike-dashboard</artifactId>
    <version>1-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>IKE Dashboard</name>
    <description>
        One window that keeps Komet versions installed side by side and current, keeps the
        knowledge bases in ~/Solor current, and launches any Komet version on any of them as an
        independent process. A stand-alone program with no Tinkar or Komet code; the design is the
        dev-ike-dashboard topic in ike-lab-documents.
    </description>
    <url>https://ike.network/ike-dashboard/</url>
    <inceptionYear>2026</inceptionYear>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <organization>
        <name>IKE Network</name>
        <url>https://ike.network</url>
    </organization>

    <scm>
        <connection>scm:git:https://github.com/IKE-Network/ike-dashboard.git</connection>
        <developerConnection>scm:git:git@github.com:IKE-Network/ike-dashboard.git</developerConnection>
        <url>https://github.com/IKE-Network/ike-dashboard</url>
        <tag>HEAD</tag>
    </scm>

    <!-- Required: ike-parent's enforcer fails an inheriting project whose effective site URL still
         points at the in-reactor location (ike-issues#380/#383). child.site.url.inherit.append.path
         is true so each module publishes under ike-dashboard/<module>/ (ike-issues#1284). -->
    <distributionManagement>
        <site child.site.url.inherit.append.path="true">
            <id>ike-site</id>
            <url>https://ike.network/ike-dashboard/</url>
        </site>
    </distributionManagement>

    <properties>
        <!-- Komet's working set builds on Java 27 with preview features, which ike-parent enables
             for every module; the dashboard follows it so one JDK builds both. -->
        <java.version>27</java.version>
        <!-- The dashboard's zips are an application, not a library: they have no place on Maven
             Central, and a Central upload cannot be withdrawn. ike-parent defaults this to true. -->
        <ike.publishToCentral>false</ike.publishToCentral>
    </properties>

    <subprojects>
        <subproject>ike-dashboard-download</subproject>
        <subproject>ike-dashboard-journal</subproject>
        <subproject>ike-dashboard-maven-extension</subproject>
        <subproject>ike-dashboard-app</subproject>
    </subprojects>
</project>
