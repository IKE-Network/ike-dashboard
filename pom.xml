<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.1.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.1.0 https://maven.apache.org/xsd/maven-4.1.0.xsd"
         root="true">
    <modelVersion>4.1.0</modelVersion>

    <parent>
        <groupId>network.ike.platform</groupId>
        <artifactId>ike-parent</artifactId>
        <version>207</version>
        <relativePath/>
    </parent>

    <groupId>network.ike.dashboard</groupId>
    <artifactId>ike-dashboard</artifactId>
    <version>1-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>IKE Dashboard</name>
    <description>
        One window that keeps Komet versions installed side by side and current, keeps the
        knowledge bases in ~/Solor current, and launches any Komet version on any of them as an
        independent process. A stand-alone program with no Tinkar or Komet code; the design is the
        dev-ike-dashboard topic in ike-lab-documents.
    </description>
    <url>https://ike.network/ike-dashboard/</url>
    <inceptionYear>2026</inceptionYear>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <organization>
        <name>IKE Network</name>
        <url>https://ike.network</url>
    </organization>

    <scm>
        <connection>scm:git:https://github.com/IKE-Network/ike-dashboard.git</connection>
        <developerConnection>scm:git:git@github.com:IKE-Network/ike-dashboard.git</developerConnection>
        <url>https://github.com/IKE-Network/ike-dashboard</url>
        <tag>HEAD</tag>
    </scm>

    <!-- Required: ike-parent's enforcer fails an inheriting project whose effective site URL still
         points at the in-reactor location (ike-issues#380/#383). child.site.url.inherit.append.path
         is true so each module publishes under ike-dashboard/<module>/ (ike-issues#1284). -->
    <distributionManagement>
        <site child.site.url.inherit.append.path="true">
            <id>ike-site</id>
            <url>https://ike.network/ike-dashboard/</url>
        </site>
    </distributionManagement>

    <properties>
        <!-- Komet's working set builds on Java 27 with preview features, which ike-parent enables
             for every module; the dashboard follows it so one JDK builds both. -->
        <java.version>27</java.version>
        <!-- The oldest JDK 27 build the dashboard may be built on, in the spelling
             requireJavaVersion compares: the rule rewrites the JDK's four-part 27.0.1.1 as
             27.0.1-1, and a range written [27.0.1.1,) refuses 27.0.1.1 itself. 27.0.1.1 carries the
             November 2026 security fixes, and the application's runtime is linked from the JDK
             running Maven (IKE-Network/ike-issues#1393, IKE-Network/ike-issues#1398). java.version
             stays the feature release: it is the compiler release, and the CI scripts read it to
             choose JDK_27_0. -->
        <java.minimum.build>27.0.1-1</java.minimum.build>
        <!-- The dashboard's zips are an application, not a library: they have no place on Maven
             Central, and a Central upload cannot be withdrawn. ike-parent defaults this to true. -->
        <ike.publishToCentral>false</ike.publishToCentral>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <!-- version from ike-parent pluginManagement -->
                <executions>
                    <!-- jpackage links the application's runtime from the JDK running Maven, so
                         Maven itself must run on a JDK that has the security fixes of
                         java.minimum.build. Declared here, in the parent of every module, so a
                         build of any of them fails fast on an older JDK 27 rather than make an
                         installer whose runtime lacks those fixes (IKE-Network/ike-issues#1398),
                         as Komet's working set does (IKE-Network/ike-issues#1393). -->
                    <execution>
                        <id>enforce-dashboard-jdk</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[${java.minimum.build},)</version>
                                    <message>The IKE Dashboard requires Maven to run on JDK 27.0.1.1 or later (set JAVA_HOME, and IntelliJ's project and Maven runner JDK). Builds are at https://jdk.java.net/27/.</message>
                                </requireJavaVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <subprojects>
        <subproject>ike-dashboard-download</subproject>
        <subproject>ike-dashboard-journal</subproject>
        <subproject>ike-dashboard-maven-extension</subproject>
        <subproject>ike-dashboard-app</subproject>
    </subprojects>
</project>
