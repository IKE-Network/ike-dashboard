<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.1.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.1.0 https://maven.apache.org/xsd/maven-4.1.0.xsd">
    <modelVersion>4.1.0</modelVersion>

    <parent>
        <groupId>network.ike.dashboard</groupId>
        <artifactId>ike-dashboard</artifactId>
    </parent>

    <artifactId>ike-dashboard-app</artifactId>
    <packaging>jar</packaging>

    <name>IKE Dashboard App</name>
    <description>
        The IKE Dashboard window: the knowledge bases in ~/Solor with what each store says about
        itself, a newer-build check against Nexus, the Komet versions installed, and the launch of
        a Komet on a knowledge base as an independent process. Also a headless command for the
        same list, check and download.
    </description>

    <properties>
        <!-- Komet's working set is on JavaFX 27 (komet-bom). -->
        <javafx.version>27</javafx.version>
        <openjfx-monocle.version>21.0.2-jpms</openjfx-monocle.version>
        <!-- The first ike-maven-plugin that notarizes an application bundle (signed-app). -->
        <ike-dashboard.notarize.version>271</ike-dashboard.notarize.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>network.ike.dashboard</groupId>
            <artifactId>ike-dashboard-download</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>network.ike.dashboard</groupId>
            <artifactId>ike-dashboard-journal</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <!-- The download code logs through SLF4J; the dashboard sends it to java.util.logging. -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-jdk14</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Headless JavaFX, so a test renders the window to an image without a display. -->
        <dependency>
            <groupId>one.jpro.platform.jpms</groupId>
            <artifactId>openjfx-monocle</artifactId>
            <version>${openjfx-monocle.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>network.ike.dashboard.app/network.ike.dashboard.app.DashboardApp</mainClass>
                    <options>
                        <option>--enable-preview</option>
                        <option>--enable-native-access=javafx.graphics</option>
                    </options>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- The application: a jpackage image of the dashboard's modules on a jlinked runtime
             (IKE-Network/ike-issues#1327), at target/app/IKE Dashboard.app on macOS and
             target/app/IKE Dashboard on Windows, unsigned. Opt in with -Papp; the macOS installer
             build adds -Psigned-app to sign and notarize it. Its version is the build clock's
             (ike:jpackage-props), as a Komet image's is, so the newest build sorts last; the
             Windows build names it with -Djpackage.app.version, since jpackage-props drops the day
             there to keep it MSI-safe.

             The installer people download, in Komet's family (KEC 2026-10-26): a .pkg on macOS and
             a per-user .msi on Windows, made from that same image into target/installer by
             exec:exec@jpackage-installer, run after the build (and, signed, after the image is
             notarized). An MSI's version allows at most 255.255.65535, so it takes
             dashboard.msi.version, which the Windows build derives from the image's. -->
        <profile>
            <id>app</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>network.ike.tooling</groupId>
                        <artifactId>ike-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>jpackage-props</id>
                                <goals>
                                    <goal>jpackage-props</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <!-- jpackage reads its options from argfiles, filtered for the version and paths. -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-resources-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>jpackage-argfiles</id>
                                <phase>process-resources</phase>
                                <goals>
                                    <goal>copy-resources</goal>
                                </goals>
                                <configuration>
                                    <outputDirectory>${project.build.directory}/jpackage</outputDirectory>
                                    <resources>
                                        <resource>
                                            <directory>src/main/jpackage</directory>
                                            <filtering>true</filtering>
                                        </resource>
                                    </resources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <!-- The modules the application runs on, beside this module's own jar. -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-dependency-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>app-modules</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>copy-dependencies</goal>
                                </goals>
                                <configuration>
                                    <includeScope>runtime</includeScope>
                                    <outputDirectory>${project.build.directory}/app-modules</outputDirectory>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <!-- jpackage refuses to write over an application already there. -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-clean-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>clean-app</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>clean</goal>
                                </goals>
                                <configuration>
                                    <excludeDefaultDirectories>true</excludeDefaultDirectories>
                                    <filesets>
                                        <fileset>
                                            <directory>${project.build.directory}/app</directory>
                                        </fileset>
                                    </filesets>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <!-- The JDK running the build makes the application and its runtime. -->
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.5.0</version>
                        <executions>
                            <execution>
                                <id>jpackage-app</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>${java.home}/bin/jpackage</executable>
                                    <!-- Paths go on the command line, not in an argfile, which reads a
                                         backslash in quotes as an escape and so mangles Windows paths. -->
                                    <arguments>
                                        <argument>@${project.build.directory}/jpackage/app.args</argument>
                                        <argument>@${project.build.directory}/jpackage/app-${dashboard.os}.args</argument>
                                        <argument>--dest</argument>
                                        <argument>${project.build.directory}/app</argument>
                                        <argument>--module-path</argument>
                                        <argument>${project.build.directory}/app-modules${path.separator}${project.build.directory}/${project.build.finalName}.jar</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                            <!-- No phase: run after the build as exec:exec@jpackage-installer. -->
                            <execution>
                                <id>jpackage-installer</id>
                                <phase>none</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>${java.home}/bin/jpackage</executable>
                                    <arguments>
                                        <argument>@${project.build.directory}/jpackage/installer-${dashboard.os}.args</argument>
                                        <argument>--app-image</argument>
                                        <argument>${project.build.directory}/app/${dashboard.app.folder}</argument>
                                        <argument>--dest</argument>
                                        <argument>${project.build.directory}/installer</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- Signed with the Developer ID under the hardened runtime, then notarized and stapled:
             what the installer build on the agent holding the build keychain runs, with -Papp. -->
        <profile>
            <id>signed-app</id>
            <properties>
                <!-- The signing identity's name, as jpackage takes it: Developer ID Application's. -->
                <codesign.user>Keith Eugene Campbell (8WUE5BZ4BP)</codesign.user>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>jpackage-app</id>
                                <configuration>
                                    <arguments combine.children="append">
                                        <argument>@${project.build.directory}/jpackage/sign.args</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                            <!-- The .pkg is signed with the Developer ID Installer of the same name. -->
                            <execution>
                                <id>jpackage-installer</id>
                                <configuration>
                                    <arguments combine.children="append">
                                        <argument>@${project.build.directory}/jpackage/sign.args</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <!-- Application bundles are notarized from ike-tooling 271 on. -->
                    <plugin>
                        <groupId>network.ike.tooling</groupId>
                        <artifactId>ike-maven-plugin</artifactId>
                        <version>${ike-dashboard.notarize.version}</version>
                        <executions>
                            <execution>
                                <id>notarize-app</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>notarize</goal>
                                </goals>
                                <configuration>
                                    <artifactDir>${project.build.directory}/app</artifactDir>
                                </configuration>
                            </execution>
                            <!-- No phase: the .pkg, once made, as ike-maven-plugin:notarize@notarize-installer. -->
                            <execution>
                                <id>notarize-installer</id>
                                <phase>none</phase>
                                <goals>
                                    <goal>notarize</goal>
                                </goals>
                                <configuration>
                                    <artifactDir>${project.build.directory}/installer</artifactDir>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- What differs by the OS the build runs on: the argfiles jpackage reads, and the image's
             folder an installer is made from. -->
        <profile>
            <id>mac</id>
            <activation>
                <os>
                    <family>mac</family>
                </os>
            </activation>
            <properties>
                <dashboard.os>mac</dashboard.os>
                <dashboard.app.folder>IKE Dashboard.app</dashboard.app.folder>
            </properties>
        </profile>
        <profile>
            <id>windows</id>
            <activation>
                <os>
                    <family>windows</family>
                </os>
            </activation>
            <properties>
                <dashboard.os>windows</dashboard.os>
                <dashboard.app.folder>IKE Dashboard</dashboard.app.folder>
                <!-- jpackage-props' Windows version is MSI-safe; the installer build names its own. -->
                <dashboard.msi.version>${jpackage.app.version}</dashboard.msi.version>
            </properties>
        </profile>
        <profile>
            <id>linux</id>
            <activation>
                <os>
                    <family>unix</family>
                    <name>Linux</name>
                </os>
            </activation>
            <properties>
                <dashboard.os>linux</dashboard.os>
                <dashboard.app.folder>IKE Dashboard</dashboard.app.folder>
            </properties>
        </profile>
    </profiles>
</project>
